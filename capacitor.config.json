{
  "appId": "com.controlbetico.app",
  "appName": "ControlBético",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f1115"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "resetWhenUpdate": true,
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    }
  }
}